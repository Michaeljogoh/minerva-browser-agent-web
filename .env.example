# Frontend (.env.local) — copy from this file. Never commit .env.local.

# NestJS API origin (Socket.IO + REST)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Must match API GATEWAY_API_KEY when that is set (production / Compose api).
# Leave unset for open local API. Do not use the placeholder string "your-key-here".
# NEXT_PUBLIC_GATEWAY_API_KEY=

# Hours a user's own OpenAI/Gemini key stays in the browser cookie (API BYOK_ENABLED=true). Default 24.
# NEXT_PUBLIC_MODEL_KEY_TTL_HOURS=24
